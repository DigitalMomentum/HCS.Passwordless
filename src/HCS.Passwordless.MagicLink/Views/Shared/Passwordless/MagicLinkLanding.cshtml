@using Microsoft.Extensions.Options
@using HCS.Passwordless.Configuration
@inject IOptionsMonitor<PasswordlessOptions> PwlOptions
@{
    var opts = PwlOptions.CurrentValue;
    var error = Context.Request.Query["error"].FirstOrDefault();
}
@if (!string.IsNullOrEmpty(error))
{
    <div role="alert" style="color:#c0392b;">
        @if (error == "expired-or-used")
        {
            <p>This sign-in link has expired or has already been used. Please <a href="@opts.LoginPath">request a new one</a>.</p>
        }
        else
        {
            <p>Sign-in failed. Please <a href="@opts.LoginPath">try again</a>.</p>
        }
    </div>
}
else
{
    <p>Checking your sign-in link…</p>
}
