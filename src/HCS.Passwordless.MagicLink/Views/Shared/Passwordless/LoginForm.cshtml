@using Microsoft.Extensions.Options
@using HCS.Passwordless.Auth
@using HCS.Passwordless.MagicLink.Configuration
@inject IOptionsMonitor<MagicLinkOptions> MlOptions
@inject IEnumerable<IPasswordlessAuthFactor> AuthFactors
@{
    var returnUrl = Context.Request.Query["returnUrl"].FirstOrDefault() ?? string.Empty;
    var magicLinkEnabled = MlOptions.CurrentValue.Enabled;
    var otpEnabled = AuthFactors.FirstOrDefault(f => f.Name == "otp")?.IsEnabled ?? false;
    var passkeyEnabled = AuthFactors.FirstOrDefault(f => f.Name == "webauthn")?.IsEnabled ?? false;
}
<form id="pwl-login-form"
      data-return-url="@returnUrl"
      style="max-width:400px;">

    @Html.AntiForgeryToken()

    <div style="margin-bottom:1rem;">
        <label for="pwl-email">Email address</label>
        <input id="pwl-email"
               name="email"
               type="email"
               autocomplete="username webauthn"
               required
               style="display:block;width:100%;margin-top:4px;" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
    </div>

    @if (magicLinkEnabled)
    {
        <button type="button" id="pwl-btn-magic-link" style="display:block;width:100%;margin-bottom:8px;">
            Email me a sign-in link
        </button>
    }

    @if (otpEnabled)
    {
        <button type="button" id="pwl-btn-otp" style="display:block;width:100%;margin-bottom:8px;">
            Email me a one-time code
        </button>
    }

    @if (passkeyEnabled)
    {
        <button type="button" id="pwl-btn-passkey" style="display:block;width:100%;margin-bottom:8px;">
            Sign in with a passkey
        </button>
    }

    <div id="pwl-message" role="alert" style="margin-top:12px;"></div>
</form>
@if (otpEnabled)
{
    <div id="pwl-otp-section" style="display:none;margin-top:16px;">
        @await Html.PartialAsync("Passwordless/OtpForm")
    </div>
}

<script type="module">
    import { initLoginForm } from '/App_Plugins/HCS.Passwordless/js/passwordless.js';
    initLoginForm(document.getElementById('pwl-login-form'));
</script>
