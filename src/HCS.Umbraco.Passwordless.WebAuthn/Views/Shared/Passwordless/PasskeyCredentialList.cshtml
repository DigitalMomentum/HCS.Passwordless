<div id="pwl-credential-list">
    @Html.AntiForgeryToken()
    <p id="pwl-creds-loading">Loading passkeys…</p>
    <ul id="pwl-creds-ul" style="list-style:none;padding:0;"></ul>
    <div id="pwl-creds-message" role="alert" style="margin-top:8px;"></div>
</div>
<script type="module">
    import { initCredentialList } from '~/App_Plugins/HCS.Passwordless/js/passwordless.js';
    initCredentialList(document.getElementById('pwl-credential-list'));
</script>
