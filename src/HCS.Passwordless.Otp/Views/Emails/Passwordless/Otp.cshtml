@model HCS.Passwordless.Otp.Notifications.Models.OtpEmailModel
@{
    Layout = "~/Views/Emails/Passwordless/_Layout.cshtml";
    ViewBag.Branding = Model.Branding;
    ViewBag.Subject = "Your sign-in code";
    var expiryMinutes = (int)Model.Expiry.TotalMinutes;
}
@section Preheader { Your @Model.Branding.ProductName sign-in code: @Model.Code }

<p style="margin:0 0 16px;font-size:16px;color:#333333;line-height:1.5;">Hi @Model.MemberName,</p>
<p style="margin:0 0 24px;font-size:15px;color:#555555;line-height:1.5;">
    Here is your one-time sign-in code for @Model.Branding.ProductName. Enter it on the sign-in page. It expires in @expiryMinutes minutes.
</p>

@* OTP code pill *@
<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    <tr>
        <td style="background-color:#f0f4ff;border:2px solid @Model.Branding.AccentColor;border-radius:8px;padding:16px 32px;text-align:center;">
            <span style="font-family:'Courier New',Courier,monospace;font-size:36px;font-weight:bold;letter-spacing:10px;color:@Model.Branding.AccentColor;">@Model.Code</span>
        </td>
    </tr>
</table>

<p style="margin:0 0 8px;font-size:14px;color:#555555;line-height:1.4;">
    Do not share this code with anyone. @Model.Branding.ProductName staff will never ask you for this code.
</p>
<p style="margin:0;font-size:13px;color:#aaaaaa;line-height:1.4;border-top:1px solid #eeeeee;padding-top:16px;">
    This code expires in @expiryMinutes minutes. If you did not request this, you can safely ignore this email.
</p>
