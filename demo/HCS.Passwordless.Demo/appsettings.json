{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "HCS.Passwordless.Otp.Controllers": "Debug"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "449d0e8c-b989-4298-a723-403b5cf16eb2",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Security": {
        "MemberBypassTwoFactorForExternalLogins": false
      },
      "ModelsBuilder": {
        "IncludeVersionNumberInGeneratedModels": false,
        "ModelsDirectory": "~/Models/Generated",
        "ModelsMode": "SourceCodeAuto"
      },
      "Imaging": {
        "HMACSecretKey": "M3xn8hlYZdhhGv5HM6j5rDr7K6dvp\u002BM0zLFIij02N89bpPyjyppMke/zKZlC4Y4f6afHZM3Kw/3osvwKIOF4IA=="
      }
    }
  },
  "uSync": {
    "Settings": {
      "RootFolder": "uSync/v17"
    }
  },
  "HCS": {
    "Authentication": {
      "LoginPath": "/login",
      "PostLoginRedirectPath": "/member",
      "MagicLink": {
        "Enabled": true,
        "TokenLifespan": "00:15:00",
        "SingleUse": true
      },
      "RateLimits": {
        "PerIpRequestsPerMinute": 10,
        "PerEmailRequestsPerHour": 5,
        "VerifyPerIpPerMinute": 20,
        "FakeWorkDelay": "00:00:00.250"
      },
      "Notifications": {
        "FromAddress": "noreply@demo.localhost",
        "FromName": "Passwordless Demo",
        "MagicLinkSubject": "Your sign-in link",
        "Branding": {
          "ProductName": "Passwordless Demo",
          "AccentColor": "#2d6cdf"
        }
      },
      "Otp": {
        "Enabled": true,
        "TokenLifespan": "00:05:00",
        "CodeLength": 6,
        "MaxAttempts": 5,
        "LockoutDuration": "00:15:00",
        "NotificationSubject": "Your sign-in code"
      },
      "WebAuthn": {
        "Enabled": false,
        "RpId": "localhost",
        "RpName": "Passwordless Demo",
        "Origins": [],
        "DecoyHmacKey": "REPLACE-WITH-A-RANDOM-SECRET-AT-LEAST-16-BYTES"
      }
    }
  }
}