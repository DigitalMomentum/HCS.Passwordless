<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Passwordless Demo</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { font-family: system-ui, -apple-system, sans-serif; margin: 0; background: #f5f5f5; color: #333; }
        .site-header { background: #2d6cdf; color: #fff; padding: 1rem 2rem; display: flex; align-items: center; justify-content: space-between; }
        .site-header a { color: #fff; text-decoration: none; font-weight: 600; }
        .site-header nav a { margin-left: 1.5rem; font-weight: normal; opacity: .85; }
        .site-header nav a:hover { opacity: 1; }
        main { max-width: 860px; margin: 2.5rem auto; padding: 0 1.5rem; }
        .card { background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.08); padding: 2rem; }
        .card h1 { margin-top: 0; font-size: 1.5rem; }
        footer { text-align: center; padding: 2rem; color: #999; font-size: .85rem; }
    </style>
</head>
<body>
    <header class="site-header">
        <a href="/">Passwordless Demo</a>
        <nav>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/member">My account</a>
            }
            else
            {
                <a href="/login">Sign in</a>
            }
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>HCS.Umbraco.Passwordless demo site</footer>
</body>
</html>
